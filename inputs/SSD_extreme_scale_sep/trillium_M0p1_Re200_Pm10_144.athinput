# Build: -DPROBLEM=newtonian_SSD -DAthena_ENABLE_MPI=ON -DAthena_FFT_BACKEND=KOKKOS.
# Trillium debug: 2 nodes, 384 MPI ranks (192/node), 01:00:00; Athena -t 00:55:00.
# The 384 MeshBlocks also divide evenly over 192 ranks on one node.
# L=cs=rho0=1; target urms=0.1, ell_drive=L/2=0.5, t0=ell_drive/urms=5.
# Re=urms*ell_drive/nu=200; Pm=nu/eta=10; Rm=2000 at the target Mach.
# All input/output times below are code units; divide by 5 to express them in t0.
# Stage 1: B=0, evolve to t=10 (2*t0), then check Mach and stationarity.
# dedt is a starting calibration: measure Mach and retune before choosing the seed.
# Stage 2: restart that checkpoint with spectral_ic/seed_on_restart=true,
# time/tlim=60 (absolute 12*t0, a further 10*t0), and spectral_ic/rms_b set to
# sqrt(2*Ekin/(V*1e10)), using its measured kinetic energy (V=1).
# Nominal rms_b=1e-6 at Mach=0.1. The zero-mean k=16 seed has common helicity.
# Correlated forcing's internal restart history must be repaired before stage 2.

<job>
basename = SSD_M0p1_Re200_Pm10_144

<mesh>
nx1 = 144
nx2 = 144
nx3 = 144
nghost = 4
x1min = 0.0
x1max = 1.0
x2min = 0.0
x2max = 1.0
x3min = 0.0
x3max = 1.0
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 24
nx2 = 18
nx3 = 18

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.3
tlim = 10.0                    # 2*t0; on seeded restart override to 60 = 12*t0
nlim = -1
ndiag = 100

<mhd>
eos = isothermal
iso_sound_speed = 1.0
reconstruct = teno5
rsolver = hlld
fofc = true
viscosity = 2.5e-4
ohmic_resistivity = 2.5e-5

<turb_driving>
driving_geometry = isotropic
driving_profile = parabola
nlow = 1
nhigh = 3
parabola_peak = 2.0
parabola_width = 0.5
sol_weight = 1.0
tcorr = 5.0                    # t0 at the driving scale
dedt = 5.0e-4

<spectral_ic>
force_free = true
nlow = 16
nhigh = 16
spectrum = band
helicity = 1
iseed = 210989
rms_b = 0.0
seed_on_restart = false

<problem>
user_hist = true                # Adds k_parallel, k_BxJ, k_BdotJ to .user.hst
# Each k is sqrt(integral(numerator)/integral(B^4)), with J=curl(B).
# Numerators: |(B.grad)B|^2, |B x J|^2, and |B.J|^2, respectively.
# Units: inverse code length; multiply by L/(2*pi) for spectral mode units.
# All three columns are zero placeholders while B=0 during spin-up.
# k_eta/k_nu below are the peak current/vorticity shells, also in inverse length.
# Peak = (2*pi/L)*argmax_s P_curl(s); no interpolation, zero if P_curl=0.
# They represent dissipation scales only after the turbulence is established.

# Mach_rms,mass = sqrt(2*(1-KE+2-KE+3-KE)/mass)/cs for this zero-mean flow.
<output1>
file_type = hst
dt = 0.1                       # t0/50
data_format = %24.16e

<output2>
file_type = power_spectrum
variable = velocity
id = velocity
history_curl_peak = k_nu        # Adds curl power to .spec and its peak to .user.hst
fft_backend = kokkos
dt = 0.1                       # t0/50

<output3>
file_type = power_spectrum
variable = magnetic_field
id = magnetic
history_curl_peak = k_eta
fft_backend = kokkos
dt = 0.1                       # t0/50

<output4>
file_type = rst
dt = 10.0                      # 2*t0; checkpoint at the end of spin-up

# Full boxes: density, all velocity components, and cell-centered magnetic field.
<output5>
file_type = bin
variable = mhd_w_bcc
id = full
dt = 1.0                       # t0/5

# Central xy slices, containing the same seven fields as the full boxes.
<output6>
file_type = bin
variable = mhd_w_bcc
id = slice_xy
slice_x3 = 0.5
dt = 0.1                       # t0/50
