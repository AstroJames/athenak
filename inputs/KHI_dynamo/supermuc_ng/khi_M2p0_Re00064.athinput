# KHI dynamo in shear units; build with -DPROBLEM=khi_dynamo.
# Target system: SuperMUC-NG.
# Shear Mach: M_Delta=2*Delta U/(cs_out+cs_in); varied through pressure.
# Units: length=delta_0, velocity=Delta U, time=t_Delta=delta_0/Delta U,
# density=<rho>_0=55/18 in the paper's box units, pressure=<rho>_0 Delta U^2,
# magnetic field=sqrt(<rho>_0) Delta U (magnetic permeability unity).
# Thus L=40, delta_0=1, Delta U=1; code time is directly t/t_Delta.
# Sweep: M_Delta=2, Re_Delta=Rm_Delta=64, Pm=1.
# Target=1000 t_Delta. History=.05, profiles=.1, slices=.5, spectra=1.
# Full volumes/restarts=100. dt_max=.05 guarantees genuine sub-shear-time samples.
# Spectra require an FFT build; use HEFFTE with MPI for distributed transforms.
# Grid 1152^3: delta_0/dx=28.8; resolution convergence must be assessed separately.
# Random magnetic ICs use a native vector-potential spectrum over modes 1--3.
# Seed RMS matches the paper's <B^2>_0=9.086e-7 in box units; fixed across the sweep.
# Bulk viscosity is omitted by request; shear viscosity and resistivity remain.
# phase_2=0 fixes the phase of the seeded velocity perturbation.

<job>
basename = khi_M2p0_Re00064

<mesh>
nx1 = 1152
nx2 = 1152
nx3 = 1152
nghost = 4
x1min = -20.0
x1max = 20.0
x2min = -20.0
x2max = 20.0
x3min = -20.0
x3max = 20.0
ix1_bc = periodic
ox1_bc = periodic
ix2_bc = periodic
ox2_bc = periodic
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 48
nx2 = 48
nx3 = 48

<time>
evolution = dynamic
integrator = rk3
cfl_number = 0.3
dt_max = 0.05
nlim = -1
tlim = 1000.0

<mhd>
eos = ideal
gamma = 1.6666666666666667
reconstruct = wenoz
rsolver = hlld
fofc = true
viscosity = 0.015625
ohmic_resistivity = 0.015625

<problem>
user_hist = true
initial_field = spectral
magnetic_rms = 0.0005453072528400847
sim_vx = 0.05
sim_vy = 0.5
sim_vz = 0.0
k_max = 2
phase_2 = 0.0
k_z = 2
sim_layer_thickness = 1.0
sim_smoothing_size = 1.0
sim_pres = 0.12588647865955596
sim_dens = 0.5454545454545454
sim_dens_perturb = 1.6666666666666667
x_tilde_1 = 10.0
x_tilde_2 = -10.0
sim_bx = 0.0
sim_by = 0.0
sim_bz = 0.0

<spectral_ic>
nlow = 1
nhigh = 3
spectrum = parabolic
iseed = 210989

<output1>
file_type = hst
data_format = %24.16e
dt = 0.05

<output2>
file_type = bin
variable = mhd_w_bcc
id = prim
dt = 100.0

<output3>
file_type = bin
variable = mhd_divb
id = divb
dt = 100.0

<output4>
file_type = rst
dt = 100.0

# Separate wide .hst tables for global, lower (x<0), and upper (x>=0) volumes.
# All means are volume-weighted; the files label Reynolds and Favre decompositions.
<output5>
file_type = khi_hst
dt = 0.05

# Native cell-centered profiles in xy, xz, yz for the same three volumes.
<output6>
file_type = khi_profiles
dt = 0.1

# Total unweighted velocity and magnetic shell-summed power, including mean shear.
# k=2*pi*n/L; no density weighting or factor 1/2. k=0 is omitted.
<output7>
file_type = power_spectrum
variable = velocity
id = velocity
dt = 1.0

<output8>
file_type = power_spectrum
variable = magnetic_field
id = magnetic
dt = 1.0

# Existing binary slices select the cell containing the requested plane.
# The binary metadata record the actual cell center (no interpolation to the plane).
<output9>
file_type = bin
variable = mhd_khi
id = khi_z0
slice_x3 = 0.0
dt = 0.5

<output10>
file_type = bin
variable = mhd_khi
id = khi_xlower
slice_x1 = -10.0
dt = 0.5

<output11>
file_type = bin
variable = mhd_khi
id = khi_xupper
slice_x1 = 10.0
dt = 0.5
