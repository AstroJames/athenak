# 256^3 hot, cooled antenna turbulence: sigma0=1, target deltaB_rms/B0~1.
# eta=nu_sh=0.5*max(vA0,0.5)/1000 gives nominal Re=Rm=1000.
# The amplitude fraction is a calibration seed and must be checked with a pilot run.

<job>
basename = antenna_sigma1_strong_256

<mesh>
nghost = 4
nx1 = 256
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 256
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 256
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<coord>
special_rel = true

<time>
evolution = dynamic
integrator = imex3
cfl_number = 0.4
tlim = 14.14213562373095
nlim = -1
ndiag = 100

<mhd>
eos = ideal
gamma = 1.3333333333333333
resistive_rel = true
electric_ct = false
resistivity_model = uniform
resistivity = 0.0003535533905932738
relativistic_viscosity = true
linearized_shear_target_1d = false
shear_viscosity = 0.0003535533905932738
shear_relaxation_time = 0.02
shear_chi_max = 2.0
relativistic_cooling = entropy
cooling_time = 0.01414213562373095
cooling_adiabat = 100.0
cooling_cfl = 0.1
rsolver = llf
reconstruct = wenoz
fofc = true
fofc_force = false

<problem>
pgen_name = rsrmhd_decaying_turbulence
user_hist = true
density = 1.0
pressure = 100.0
velocity_rms = 0.0
magnetic_configuration = uniform_z
magnetic_rms = 0.0
plasma_beta = 0.49875311720698257
profile_name = antenna_sigma1_strong_256

<velocity_spectral_ic>
nlow = 1
nhigh = 2
spectrum = parabolic
iseed = 1837

<magnetic_spectral_ic>
nlow = 1
nhigh = 2
spectrum = parabolic
iseed = 918273

<antenna_driving>
model = fourier_oscillating_ou
mode_set = zhdankin8
current_geometry = apar_double_curl
guide_axis = z
apply_source = true
va_reference = initial_mean
frequency_model = zhdankin2018
frequency_factor = 0.6
decorrelation_factor = 0.27566444771089604
amplitude_normalization = zhdankin
amplitude_fraction_plus = 0.65
amplitude_fraction_minus = 0.65
initial_state = stationary
seed = 210989

<output1>
file_type = hst
dt = 0.0353553390593274
user_hist_only = true
data_format = %20.12e

<output2>
file_type = bin
variable = mhd_w_bcc
id = prim
dt = 0.353553390593274

<output3>
file_type = bin
variable = antenna_current
id = antenna
dt = 0.353553390593274

<output4>
file_type = rst
dt = 1.414213562373095
