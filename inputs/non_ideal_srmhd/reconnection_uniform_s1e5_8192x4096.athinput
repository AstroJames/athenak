# Lowest-resolution uniform-grid scout for the S=1e5 Harris-sheet run.
# At 2048 cells/L, eta is comparable to the WENO-Z numerical-resistivity estimate.

<job>
basename  = reconnection_uniform_s1e5_8192x4096

<mesh>
nghost    = 4
nx1       = 8192
x1min     = -2.0
x1max     = 2.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 4096
x2min     = -1.0
x2max     = 1.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 256
nx2       = 256
nx3       = 1

<coord>
special_rel = true

<time>
evolution  = dynamic
integrator = imex3
cfl_number = 0.4
tlim       = 2.0
nlim       = -1
ndiag      = 100

<mhd>
eos                    = ideal
gamma                  = 1.3333333333333333
resistive_rel          = true
electric_ct            = false
resistivity_model      = uniform
resistivity            = 1.9069251784911845e-5
relativistic_viscosity = false
rsolver                = llf
reconstruct            = wenoz
fofc                   = true

<problem>
pgen_name              = rsrmhd_reconnection
user_hist              = true
field                  = 1.0
guide_field            = 0.0
sheet_width            = 0.02
density                = 0.1
sheet_density_contrast = 3.0
pressure               = 1.0e-3
perturbation           = 0.15
pinch_steepness        = 200.0
pinch_along_offset     = 10.0
pinch_cross_offset     = 2.0

<output1>
file_type   = hst
dt          = 0.01
data_format = %20.12e

<output2>
file_type = bin
variable  = mhd_w_bcc
id        = primitive
dt        = 0.1

<output3>
file_type = bin
variable  = mhd_e3
id        = electric
dt        = 0.1

<output4>
file_type = bin
variable  = mhd_eta
id        = eta
dt        = 0.1

<output5>
file_type = bin
variable  = mhd_jz
id        = current
dt        = 0.1

<output6>
file_type = rst
dt        = 0.25
