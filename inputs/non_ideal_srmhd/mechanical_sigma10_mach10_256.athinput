# 256^3 cooled four-acceleration turbulence: sigma0=10, target Mach=10.
# Stable pilot cap; Mach=10 is an acceptance target, not a guaranteed outcome.

<job>
basename = mechanical_sigma10_mach10_256

<mesh>
nghost = 4
nx1 = 256
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 256
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 256
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<coord>
special_rel = true

<time>
evolution = dynamic
integrator = imex3
cfl_number = 0.4
tlim = 10.0
nlim = -1
ndiag = 100

<mhd>
eos = ideal
gamma = 1.3333333333333333
resistive_rel = true
electric_ct = false
resistivity_model = uniform
resistivity = 0.0004767312946227962
relativistic_viscosity = true
linearized_shear_target_1d = false
shear_viscosity = 0.0004767312946227962
shear_relaxation_time = 0.02
shear_chi_max = 2.0
relativistic_cooling = entropy
cooling_time = 0.01
cooling_adiabat = 0.0018891687657430734
cooling_cfl = 0.1
rsolver = llf
reconstruct = wenoz
fofc = true
fofc_force = false

<problem>
pgen_name = rsrmhd_decaying_turbulence
user_hist = true
density = 1.0
pressure = 0.0018891687657430734
velocity_rms = 0.0
magnetic_configuration = uniform_z
magnetic_rms = 0.0
plasma_beta = 0.000375
profile_name = mechanical_sigma10_mach10_256

<velocity_spectral_ic>
nlow = 1
nhigh = 3
spectrum = parabolic
iseed = 1837

<turb_driving>
relativistic_forcing = mechanical
tcorr = 1.0
accel_rms = 1.25
nlow = 1
nhigh = 3
driving_geometry = isotropic
driving_profile = parabola
sol_weight = 1.0
parabola_peak = 2.0
parabola_width = 0.5

<output1>
file_type = hst
dt = 0.025
user_hist_only = true
data_format = %20.12e

<output2>
file_type = bin
variable = mhd_w_bcc
id = prim
dt = 0.25

<output3>
file_type = bin
variable = turb_force
id = force
dt = 0.25

<output4>
file_type = rst
dt = 1.0
