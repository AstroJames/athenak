# 256^3 cooled relativistic small-scale dynamo: Re=200, Rm=200, Pm=1.
# Four-acceleration driving is fully solenoidal, targets M_rms=0.1, and has tcorr=t0.
# The zero-mean Gaussian magnetic seed has sigma_rms=1e-6 and no guide field.

<job>
basename = small_scale_dynamo_re200_rm200_256

<mesh>
nghost = 4
nx1 = 256
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 256
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 256
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<coord>
special_rel = true

<time>
evolution = dynamic
integrator = imex3
cfl_number = 0.4
tlim = 96.82458365518542
nlim = -1
ndiag = 100

<mhd>
eos = ideal
gamma = 1.3333333333333333
resistive_rel = true
electric_ct = false
resistivity_model = uniform
resistivity = 0.00012909944487358055
relativistic_viscosity = true
linearized_shear_target_1d = false
shear_viscosity = 0.00012909944487358055
shear_relaxation_time = 0.02
shear_chi_max = 2.0
relativistic_cooling = entropy
cooling_time = 0.09682458365518543
cooling_adiabat = 1.0
cooling_cfl = 0.1
rsolver = llf
reconstruct = wenoz
fofc = true
fofc_force = false

<problem>
pgen_name = rsrmhd_decaying_turbulence
user_hist = true
density = 1.0
pressure = 1.0
velocity_rms = 0.0
magnetic_configuration = random
sigma_rms = 1.0e-6
profile_name = small_scale_dynamo_re200_rm200_256

<magnetic_spectral_ic>
nlow = 1
nhigh = 3
spectrum = driving_parabolic
parabola_peak = 2.0
parabola_width = 0.5
iseed = 918273

<turb_driving>
relativistic_forcing = mechanical
tcorr = 9.682458365518542
accel_rms = 0.0115
nlow = 1
nhigh = 3
driving_geometry = isotropic
driving_profile = parabola
sol_weight = 1.0
parabola_peak = 2.0
parabola_width = 0.5

<output1>
file_type = hst
dt = 0.24206145913796355
user_hist_only = true
data_format = %20.12e

<output2>
file_type = bin
variable = mhd_w_bcc
id = prim
dt = 2.4206145913796355

<output3>
file_type = rst
dt = 9.682458365518542
