# High-resolution paper decaying-turbulence setup: Re=50, Pm=100, Rm=5000.
# This preserves the matched paper initial condition while extending the Pm scan.

<job>
basename  = decaying_turbulence_re50_pm100_8192

<mesh>
nghost    = 4
nx1       = 8192
x1min     = 0.0
x1max     = 1.0
ix1_bc    = periodic
ox1_bc    = periodic
nx2       = 8192
x2min     = 0.0
x2max     = 1.0
ix2_bc    = periodic
ox2_bc    = periodic
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 256
nx2       = 256
nx3       = 1

<coord>
special_rel = true

<time>
evolution  = dynamic
integrator = imex3
cfl_number = 0.4
tlim       = 2.0
nlim       = -1
ndiag      = 100

<mhd>
eos                        = ideal
gamma                      = 1.3333333333333333
resistive_rel              = true
electric_ct                = false
resistivity_model          = uniform
resistivity                = 0.000012
relativistic_viscosity     = true
linearized_shear_target_1d = false
shear_viscosity            = 0.0012
shear_relaxation_time      = 0.02
shear_chi_max              = 2.0
rsolver                    = llf
reconstruct                = wenoz
fofc                       = true
fofc_force                 = false

<problem>
pgen_name      = rsrmhd_decaying_turbulence
user_hist      = true
density        = 1.0
pressure       = 1.0
velocity_rms   = 0.15
magnetic_rms   = 0.15
profile_name   = decaying_turbulence_re50_pm100_8192

<velocity_spectral_ic>
nlow           = 1
nhigh          = 4
spectrum       = parabolic
iseed          = 1837

<magnetic_spectral_ic>
nlow           = 1
nhigh          = 4
spectrum       = parabolic
iseed          = 918273

<output1>
file_type       = hst
dt              = 0.02
user_hist_only  = true
data_format     = %20.12e

<output2>
file_type       = bin
variable        = mhd_w_bcc
id              = prim
dt              = 0.5

<output3>
file_type       = rst
dt              = 0.5
