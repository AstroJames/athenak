# Pressure-balanced relativistic Harris-sheet reconnection regression.

<job>
basename  = rsrmhd_reconnection

<mesh>
nghost    = 4
nx1       = 256
x1min     = -2.0
x1max     = 2.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 128
x2min     = -1.0
x2max     = 1.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 1
x3min     = -0.5
x3max     = 0.5
ix3_bc    = periodic
ox3_bc    = periodic

<meshblock>
nx1       = 128
nx2       = 64
nx3       = 1

<coord>
special_rel = true

<time>
evolution  = dynamic
integrator = imex3
cfl_number = 0.4
tlim       = 1.0e-3
nlim       = 1
ndiag      = 1

<mhd>
eos                    = ideal
gamma                  = 1.3333333333333333
resistive_rel          = true
electric_ct            = false
resistivity_model      = uniform
resistivity            = 1.0e-3
eta_floor              = 1.0e-8
eta_scale              = 1.0e-2
number_per_mass        = 1.0
relativistic_viscosity = false
rsolver                = llf
reconstruct            = wenoz
fofc                   = true

<problem>
pgen_name              = rsrmhd_reconnection
user_hist              = true
field                  = 1.0
guide_field            = 0.0
sheet_width            = 0.02
density                = 0.1
sheet_density_contrast = 3.0
pressure               = 1.0e-3
perturbation           = 0.15
pinch_steepness        = 200.0
pinch_along_offset     = 10.0
pinch_cross_offset     = 2.0

<output1>
file_type   = hst
dt          = 1.0e-3
data_format = %20.12e

<output2>
file_type   = bin
variable    = mhd_w_bcc
id          = primitive
dt          = 1.0e-3

<output3>
file_type   = bin
variable    = mhd_e3
id          = electric
dt          = 1.0e-3

<output4>
file_type   = bin
variable    = mhd_eta
id          = eta
dt          = 1.0e-3
