# MPI task-order smoke for antenna-driven, cooled, mechanically driven,
# visco-resistive SRMHD.

<job>
basename = rsrmhd_antenna_coupled

<mesh>
nghost = 2
nx1 = 8
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<coord>
special_rel = true

<time>
evolution = dynamic
integrator = imex2
cfl_number = 0.3
tlim = 10.0
nlim = 4
ndiag = 1

<mhd>
eos = ideal
gamma = 1.3333333333333333
resistive_rel = true
electric_ct = true
resistivity_model = uniform
resistivity = 0.01
relativistic_viscosity = true
linearized_shear_target_1d = false
shear_viscosity = 0.01
shear_relaxation_time = 0.05
shear_chi_max = 2.0
relativistic_cooling = entropy
cooling_time = 0.2
cooling_adiabat = 1.0
cooling_cfl = 0.1
rsolver = llf
reconstruct = plm
fofc = false
fofc_force = false

<problem>
pgen_name = rsrmhd_decaying_turbulence
user_hist = true
density = 1.0
pressure = 1.2
velocity_rms = 0.0
magnetic_configuration = uniform_z
magnetic_rms = 0.0
plasma_beta = 1.0
profile_name = rsrmhd_antenna_coupled
restart_state_name = rsrmhd_antenna_coupled_state

<velocity_spectral_ic>
nlow = 1
nhigh = 2
spectrum = parabolic
iseed = 1837

<magnetic_spectral_ic>
nlow = 1
nhigh = 2
spectrum = parabolic
iseed = 918273

<turb_driving>
relativistic_forcing = mechanical
tcorr = 0.2
accel_rms = 0.01
nlow = 1
nhigh = 2
driving_geometry = isotropic
driving_profile = band
sol_weight = 1.0

<antenna_driving>
model = fourier_oscillating_ou
mode_set = zhdankin8
nperp_min = 1
nperp_max = 2
nparallel_min = 1
nparallel_max = 2
current_envelope = band
current_geometry = apar_double_curl
guide_axis = z
apply_source = true
va_reference = initial_mean
frequency_model = zhdankin2018
frequency_factor = 0.6
decorrelation_factor = 0.5
amplitude_normalization = apar_rms
apar_rms_plus = 0.0001
apar_rms_minus = 0.0001
initial_state = stationary
seed = 210989

<output1>
file_type = hst
dcycle = 1
user_hist_only = true
data_format = %.17e

<output2>
file_type = rst
dcycle = 4
