# Regression for post-implicit CC electric/shear ghost synchronization.
# Before the dedicated exchange was added, this weak-field periodic run failed
# viscous primitive recovery in a ghost cell near t=5.5.

<job>
basename = rsrmhd_turb_ssd_ghost_exchange

<mesh>
nghost = 4
nx1 = 8
x1min = 0.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 8
x2min = 0.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 8
x3min = 0.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 8
nx3 = 8

<coord>
special_rel = true

<time>
evolution = dynamic
integrator = imex3
cfl_number = 0.4
tlim = 7.0
nlim = -1
ndiag = 20

<mhd>
eos = ideal
gamma = 1.3333333333333333
resistive_rel = true
electric_ct = false
resistivity_model = uniform
resistivity = 6.454972243679028e-05
relativistic_viscosity = true
linearized_shear_target_1d = false
shear_viscosity = 0.00012909944487358055
shear_relaxation_time = 0.02
shear_chi_max = 2.0
relativistic_cooling = entropy
cooling_time = 0.09682458365518543
cooling_adiabat = 1.0
cooling_cfl = 0.1
rsolver = llf
reconstruct = wenoz
fofc = true
fofc_force = false

<problem>
pgen_name = rsrmhd_decaying_turbulence
user_hist = true
density = 1.0
pressure = 1.0
velocity_rms = 0.0
magnetic_configuration = random
sigma_rms = 1.0e-6
profile_name = rsrmhd_turb_ssd_ghost_exchange

<magnetic_spectral_ic>
nlow = 1
nhigh = 3
spectrum = driving_parabolic
parabola_peak = 2.0
parabola_width = 0.5
iseed = 918273

<turb_driving>
relativistic_forcing = mechanical
tcorr = 9.682458365518542
accel_rms = 0.001
nlow = 1
nhigh = 3
driving_geometry = isotropic
driving_profile = parabola
sol_weight = 1.0
parabola_peak = 2.0
parabola_width = 0.5

<output1>
file_type = hst
dt = 0.5
user_hist_only = true
data_format = %20.12e
